ad PRC_LSB1_01 PRM1.p2.o -eom1.f 0 1
ad PRC_LSB1_20 PRM1.p2.o -eom1.f 2 0
ad PRC_LSB1_02 PRM1.p2.o -eom1.f 0 2

ad PRC_USB2_00 PRM1.p2.o eom2.f 0 0
